# =========================================================
# CaloVision AI Backend - Environment Configuration Sample
# =========================================================

# Plesk thường inject PORT — để trống hoặc khớp Application Port trong Plesk
PORT=5001
NODE_ENV=production
JWT_SECRET=change_me_to_a_long_random_secret

# SQLite (đơn giản trên Windows/Plesk). File nằm cạnh schema: prisma/prod.db
DATABASE_URL="file:./prod.db"

# Google Gemini AI API Key
GEMINI_API_KEY=your_gemini_api_key_here